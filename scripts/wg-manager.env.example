# /root/secrets/wg-manager.env — пример. Скопируйте и заполните:
#   cp /root/wg-manager.env.example /root/secrets/wg-manager.env
#   chmod 600 /root/secrets/wg-manager.env

# --- WireGuard override (опционально, дефолты из server-infra.env) ---
# SERVER_HOST=example.com
# WAN_IF=eth0
# IFACE=wg0
# CLIENT_DNS=1.1.1.1
# CLIENT_MTU=1420
# CLIENT_IP_START=2
# CLIENT_IP_END=254
# GEN_QR=true
# ARCHIVE_DIR=/var/lib/wg-manager/archives
# KEEP_ARCHIVE=false

# --- SMTP для команды mail ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_SECURE=starttls
# MAIL_FROM=user@example.com
# MAIL_TO=user@example.com
# MAIL_SUBJECT_PREFIX=[wg]
