# /root/secrets/backup.env — конфиг backup-all.sh
#   cp /root/services-src/scripts/backup.env.example /root/secrets/backup.env
#   chmod 600 /root/secrets/backup.env

# --- Основные ---
# BACKUP_DIR=/var/backups/server-services
# KEEP_DAYS=14
# MIN_FREE_MB=500
# LOCK_FILE=/var/run/backup-all.lock

# --- Что бэкапить (через пробел) ---
# SOURCES="/root/secrets /etc/wireguard"

# --- Docker volumes (через пробел, пусто = не бэкапить) ---
# DOCKER_VOLUMES=""
